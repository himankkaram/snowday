# Copy this file to .env and edit. Never commit .env.

# Port for the Node game server (Socket.IO + /health).
PORT=3000

# Port for the Vite dev server (the URL phones and the host screen open in dev).
CLIENT_PORT=5173

# Secret the host screen must present to claim the host role.
# Open the host screen as /host.html?key=<HOST_KEY>
HOST_KEY=change-me-before-the-event

# Serve the dev site over HTTPS with a self-signed certificate (needed for phone motion sensors on a LAN).
# Phones will show a certificate warning you must accept once. Not needed when using a tunnel.
DEV_HTTPS=false

# Public base URL for the QR code, e.g. your cloudflared tunnel URL. Leave blank to use the host page's own address.
VITE_PUBLIC_URL=

# Log every message (noisy). true/false
DEBUG_LOG=false
